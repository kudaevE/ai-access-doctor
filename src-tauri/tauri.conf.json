{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Access Doctor",
  "version": "1.0.0",
  "identifier": "com.aiaccessdoctor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Access Doctor — Диагностика подключения к ИИ-сервисам",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
